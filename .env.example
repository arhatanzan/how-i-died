# Admin credentials for accessing /admin panel and database
ADMIN_USERNAME=keeper
ADMIN_PASSWORD=change-me

# Optional: separate signing secret for session cookies (defaults to a hash of the credentials)
AUTH_SECRET=

# File-based database location (auto-created at .data/tables/)
# This is NOT committed to git and NOT served publicly
# Leave blank to use default (.data/)
FILE_DB_PATH=

# NETLIFY_DB_URL is supplied by Netlify Database (and by Netlify CLI locally).
# Keep it server-only. Never prefix a database URL with VITE_ or commit its value.

