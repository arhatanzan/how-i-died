# Git configuration for storing binary files

# Images
.store/images/*.jpg binary
.store/images/*.jpeg binary
.store/images/*.png binary
.store/images/*.gif binary
.store/images/*.webp binary
.store/images/*.bmp binary

# Video and audio - tracked with Git LFS for files over 100MB
.store/media/**/*.webm filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.mkv filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.mov filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.avi filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.flv filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.wav filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.m4a filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.ogg filter=lfs diff=lfs merge=lfs -text
.store/media/**/*.bin filter=lfs diff=lfs merge=lfs -text

# Metadata (text files)
.store/**/*.json text
.store/index.jsonl text
.store/dedup/**.json text
